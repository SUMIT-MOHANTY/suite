{
  "name": "todos-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently 'npm run dev:backend' 'npm run dev:frontend'",
    "dev:frontend": "npm -w frontend run dev",
    "dev:backend": "npm -w backend run dev",
    "postinstall": "npm audit fix"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "npm": "^10.1.0"
  }
}
