{
  "name": "todos-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm -w frontend run dev",
    "dev:backend": "npm -w backend run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm -w frontend run build",
    "build:backend": "npm -w backend run build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm -w frontend test",
    "test:backend": "npm -w backend test",
    "postinstall": "npm audit fix"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "npm": "^10.1.0"
  }
}
